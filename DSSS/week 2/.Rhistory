## Interactive plot
aweSOMplot(som = the.som, type = "Radar", data = plot.data,
variables = c("pf_rol", "pf_ss", "pf_movement", "pf_religion", "pf_association", "pf_expression", "pf_identity", "ef_government", "ef_legal", "ef_money", "ef_trade", "ef_regulation"),
superclass = superclasses, obsNames = plot.data[, "V1"],
legendFontsize = 34,
size = 1000)
