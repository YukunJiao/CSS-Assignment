element$get_attribute("xpath", "//div[@class = 'recent-hot-item is_movie']")
element$get_css_value("xpath", "//div[@class = 'recent-hot-movie']")
element$get_css_value()
element$get_rect()
element$shadow_root()
element
screenshot(session)
